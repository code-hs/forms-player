{
	"name": "form-generator",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"serve": "cross-env CUSTOM_MODE=dev vue-cli-service serve",
		"serve local": "_local:copy:all:to-local && serve run",
		" ": "",
		"build:min": "cross-env CUSTOM_MODE=prod vue-cli-service build && npm run _copy:bundle:to-api-public-dir && npm run _local:copy:bundle",
		"build:full         (with sourcemap, with comments, logs)": "cross-env CUSTOM_MODE=dev vue-cli-service build && npm run _copy:bundle:to-api-public-dir  && npm run _local:copy:bundle",
		"  ": "",
		"lint": "vue-cli-service lint --no-fix --ext .ts,.js,.vue ./src/",
		"test": "jest",
		"analyze": "cross-env CUSTOM_MODE=analyze vue-cli-service build",
		"   ": "",
		"present: deploy": "npm run build:min && npm run _present:copy-files && cd ..\\client-present && git add . && git commit -m 'autodeploy' && git push origin master",
		"    ": "",
		"_local:copy:all:to-local": "npm run _local:copy:bundle && npm run _local:copy:scheme && npm run _local:copy:locales && npm run _local:copy:WDFL",
		"_local:copy:bundle": "copy dist\\form-widget-g.js run\\local\\form-widget-g.js",
		"_local:copy:scheme": "copy ..\\api\\store\\projects\\62508e2544f0831be0b66a0b\\scheme.json run\\local\\scheme.json",
		"_local:copy:locales": "copy ..\\api\\store\\projects\\62508e2544f0831be0b66a0b\\locales.json run\\local\\locales.json",
		"_local:copy:WDFL": "copy ..\\api\\public\\client\\widget-form-loader.min.js run\\local\\widget-form-loader.min.js",
		"_copy:bundle:to-api-public-dir": "copy dist\\form-widget-g.js ..\\api\\public\\client\\bundles\\form-widget-g.js",
		"_present:copy-files": "npm run _local:copy:all:to-local && xcopy run\\local ..\\client-present\\public\\local /h /i /c /k /e /r /y && copy run\\local.html ..\\client-present\\public\\index.html"
	},
	"dependencies": {
		"document-register-element": "^1.11.0",
		"v-mask": "^2.3.0",
		"vue": "^2.5.16",
		"vue-custom-element": "^3.2.2",
		"vuex": "^3.0.1"
	},
	"devDependencies": {
		"@babel/plugin-transform-modules-commonjs": "^7.15.4",
		"@babel/preset-env": "^7.16.4",
		"@babel/preset-typescript": "^7.17.12",
		"@jest/globals": "^27.2.3",
		"@typescript-eslint/parser": "^5.28.0",
		"@vue/cli-plugin-babel": "^3.4.1",
		"@vue/cli-plugin-eslint": "^3.4.1",
		"@vue/cli-service": "^3.5.3",
		"@vue/eslint-config-airbnb": "^5.3.0",
		"@vue/test-utils": "^1.2.2",
		"babel-core": "^7.0.0-bridge.0",
		"babel-jest": "^27.2.3",
		"cross-env": "^7.0.3",
		"eslint": "^7.32.0",
		"eslint-plugin-vue": "^7.18.0",
		"jest": "^27.2.3",
		"jsdom": "^17.0.0",
		"node-sass": "^6.0.1",
		"sass": "^1.42.1",
		"sass-loader": "^7.0.3",
		"serve": "^13.0.2",
		"uglifyjs-webpack-plugin": "^2.2.0",
		"vue-jest": "^3.0.7",
		"vue-template-compiler": "^2.5.16",
		"webpack": "^4.46.0",
		"webpack-bundle-analyzer": "^4.4.2"
	},
	"browserslist": [
		"> 0.5%",
		"not dead"
	],
	"jest": {
		"moduleFileExtensions": [
			"js",
			"json",
			"vue",
			"ts"
		],
		"transform": {
			".*\\.(vue)$": "vue-jest",
			"^.+\\.js$": "<rootDir>/node_modules/babel-jest",
			"^.+\\.ts$": "<rootDir>/node_modules/babel-jest"
		},
		"moduleNameMapper": {
			"^@/(.*)$": "<rootDir>/src/$1"
		}
	}
}
