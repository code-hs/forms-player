{
	"name": "form-generator",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"serve": "cross-env CUSTOM_MODE=dev vue-cli-service serve",
		" ": "",
		"build:min": "npm run _cp:all-asset-files && cross-env CUSTOM_MODE=prod vue-cli-service build",
		"build:full         (with sourcemap, with comments, logs)": "npm run _cp:all-asset-files && cross-env CUSTOM_MODE=dev vue-cli-service build",
		"present: deploy": "wrangler publish",
		"  ": "",
		"lint": "vue-cli-service lint --no-fix --ext .ts,.js,.vue ./src/",
		"test": "jest",
		"analyze": "cross-env CUSTOM_MODE=analyze vue-cli-service build",
		"    ": "",
		"_cp:all-asset-files": "npm run _cp:all-to-run-dir && npm run _cp:all-to-public-dir",
		"      ": "",
		"_cp:all-to-run-dir": "npm run _cp:r:bundle && npm run _cp:r:scheme && npm run _cp:r:locales && npm run _cp:r:WDFL",
		"_cp:r:bundle": "copy dist\\form-widget-g.js run\\assets\\form-widget-g.js",
		"_cp:r:scheme": "copy ..\\api\\store\\projects\\62508e2544f0831be0b66a0b\\scheme.json run\\assets\\scheme.json",
		"_cp:r:locales": "copy ..\\api\\store\\projects\\62508e2544f0831be0b66a0b\\locales.json run\\assets\\locales.json",
		"_cp:r:WDFL": "copy ..\\widget-form-loader\\dist\\widget-form-loader.min.js run\\assets\\widget-form-loader.min.js",
		"     ": "",
		"_cp:all-to-public-dir": "npm run _cp:p:bundle && npm run _cp:p:scheme && npm run _cp:p:locales && npm run _cp:p:WDFL",
		"_cp:p:bundle": "copy dist\\form-widget-g.js public\\assets\\form-widget-g.js",
		"_cp:p:scheme": "copy ..\\api\\store\\projects\\62508e2544f0831be0b66a0b\\scheme.json public\\assets\\scheme.json",
		"_cp:p:locales": "copy ..\\api\\store\\projects\\62508e2544f0831be0b66a0b\\locales.json public\\assets\\locales.json",
		"_cp:p:WDFL": "copy ..\\widget-form-loader\\dist\\widget-form-loader.min.js public\\assets\\widget-form-loader.min.js"
	},
	"dependencies": {
		"document-register-element": "^1.11.0",
		"v-mask": "^2.3.0",
		"vue": "^2.5.16",
		"vue-custom-element": "^3.2.2",
		"vuex": "^3.0.1"
	},
	"devDependencies": {
		"@babel/plugin-transform-modules-commonjs": "^7.15.4",
		"@babel/preset-env": "^7.16.4",
		"@babel/preset-typescript": "^7.17.12",
		"@jest/globals": "^27.2.3",
		"@typescript-eslint/parser": "^5.28.0",
		"@vue/cli-plugin-babel": "^3.4.1",
		"@vue/cli-plugin-eslint": "^3.4.1",
		"@vue/cli-service": "^3.5.3",
		"@vue/eslint-config-airbnb": "^5.3.0",
		"@vue/test-utils": "^1.2.2",
		"babel-core": "^7.0.0-bridge.0",
		"babel-jest": "^27.2.3",
		"cross-env": "^7.0.3",
		"eslint": "^7.32.0",
		"eslint-plugin-vue": "^7.18.0",
		"jest": "^27.2.3",
		"jsdom": "^17.0.0",
		"node-sass": "^6.0.1",
		"sass": "^1.42.1",
		"sass-loader": "^7.0.3",
		"serve": "^13.0.2",
		"uglifyjs-webpack-plugin": "^2.2.0",
		"vue-jest": "^3.0.7",
		"vue-template-compiler": "^2.5.16",
		"webpack": "^4.46.0",
		"webpack-bundle-analyzer": "^4.4.2"
	},
	"browserslist": [
		"> 0.5%",
		"not dead"
	],
	"jest": {
		"moduleFileExtensions": [
			"js",
			"json",
			"vue",
			"ts"
		],
		"transform": {
			".*\\.(vue)$": "vue-jest",
			"^.+\\.js$": "<rootDir>/node_modules/babel-jest",
			"^.+\\.ts$": "<rootDir>/node_modules/babel-jest"
		},
		"moduleNameMapper": {
			"^@/(.*)$": "<rootDir>/src/$1"
		}
	}
}
