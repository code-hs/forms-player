{
	"name": "form-generator",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"serve": "vue-cli-service serve",
		" ": "",
		"build prod": "cross-env NODE_MODE=prod vue-cli-service build",
		"build dev": "cross-env NODE_MODE=dev vue-cli-service build",
		"  ": "",
		"analyze": "cross-env NODE_MODE=analyze vue-cli-service build",
		"lint": "vue-cli-service lint",
		"test": "jest"
	},
	"dependencies": {
		"axios": "^0.21.4",
		"document-register-element": "^1.11.0",
		"vue": "^2.5.16",
		"vue-custom-element": "^3.2.2",
		"vuex": "^3.0.1"
	},
	"devDependencies": {
		"@babel/plugin-transform-modules-commonjs": "^7.15.4",
		"@jest/globals": "^27.2.3",
		"@vue/cli-plugin-babel": "^3.4.1",
		"@vue/cli-plugin-eslint": "^3.4.1",
		"@vue/cli-service": "^3.5.3",
		"@vue/eslint-config-airbnb": "^5.3.0",
		"@vue/test-utils": "^1.2.2",
		"babel-core": "^7.0.0-bridge.0",
		"babel-jest": "^27.2.3",
		"cross-env": "^7.0.3",
		"eslint": "^7.32.0",
		"eslint-plugin-vue": "^7.18.0",
		"jest": "^27.2.3",
		"jsdom": "^17.0.0",
		"node-sass": "^6.0.1",
		"sass": "^1.42.1",
		"sass-loader": "^7.0.3",
		"uglifyjs-webpack-plugin": "^2.2.0",
		"vue-jest": "^3.0.7",
		"vue-template-compiler": "^2.5.16",
		"webpack": "^4.46.0",
		"webpack-bundle-analyzer": "^4.4.2"
	},
	"eslintConfig": {
		"root": true,
		"env": {
			"node": true
		},
		"extends": [
			"plugin:vue/essential",
			"@vue/airbnb"
		],
		"rules": {
			"no-tabs": "off",
			"indent": "off",
			"import/extensions": "off",
			"linebreak-style": "off",
			"arraysInObjects": "off",
			"object-curly-spacing": [
				"error",
				"never"
			],
			"arrow-parens": [
				"error",
				"as-needed"
			],
			"no-shadow": "off",
			"no-param-reassign": "off",
			"vue/comment-directive": "off",
			"no-multiple-empty-lines": "off",
			"no-trailing-spaces": "off",
			"comma-dangle": [
				"error",
				{
					"functions": "never",
					"arrays": "ignore",
					"objects": "ignore",
					"imports": "ignore",
					"exports": "ignore"
				}
			],
			"implicit-arrow-linebreak": "off",
			"function-paren-newline": "off",
			"vue/no-mutating-props": "off",
			"import/no-extraneous-dependencies": "off",
			"no-underscore-dangle": "off"
		},
		"parserOptions": {
			"parser": "babel-eslint"
		}
	},
	"browserslist": [
		"> 1%",
		"not dead"
	],
	"jest": {
		"moduleFileExtensions": [
			"js",
			"json",
			"vue"
		],
		"transform": {
			".*\\.(vue)$": "vue-jest",
			"^.+\\.js$": "<rootDir>/node_modules/babel-jest"
		},
		"transformIgnorePatterns": [
			"/node_modules/(?!@babel/runtime)"
		],
		"moduleNameMapper": {
			"^@/(.*)$": "<rootDir>/src/$1"
		},
		"testEnvironment": "jsdom"
	}
}
