{
	"name": "form-generator",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"serve": "cross-env CUSTOM_MODE=dev CUSTOM_RUN_COMMAND=serve vue-cli-service serve",
		" ": "",
		"build min        (clear comments/logs)": "cross-env CUSTOM_MODE=prod vue-cli-service build",
		"build full         (with sourcemap, with comments, logs)": "cross-env CUSTOM_MODE=dev vue-cli-service build",
		"  ": "",
		"lint": "vue-cli-service lint",
		"test": "jest",
		"analyze": "cross-env CUSTOM_MODE=analyze vue-cli-service build"
	},
	"dependencies": {
		"axios": "^0.21.4",
		"document-register-element": "^1.11.0",
		"vue": "^2.5.16",
		"vue-custom-element": "^3.2.2",
		"vuex": "^3.0.1"
	},
	"devDependencies": {
		"@babel/plugin-transform-modules-commonjs": "^7.15.4",
		"@babel/preset-env": "^7.16.4",
		"@jest/globals": "^27.2.3",
		"@vue/cli-plugin-babel": "^3.4.1",
		"@vue/cli-plugin-eslint": "^3.4.1",
		"@vue/cli-service": "^3.5.3",
		"@vue/eslint-config-airbnb": "^5.3.0",
		"@vue/test-utils": "^1.2.2",
		"babel-core": "^7.0.0-bridge.0",
		"babel-jest": "^27.2.3",
		"cross-env": "^7.0.3",
		"eslint": "^7.32.0",
		"eslint-plugin-vue": "^7.18.0",
		"jest": "^27.2.3",
		"jsdom": "^17.0.0",
		"node-sass": "^6.0.1",
		"sass": "^1.42.1",
		"sass-loader": "^7.0.3",
		"uglifyjs-webpack-plugin": "^2.2.0",
		"vue-jest": "^3.0.7",
		"vue-template-compiler": "^2.5.16",
		"webpack": "^4.46.0",
		"webpack-bundle-analyzer": "^4.4.2"
	},
	"eslintConfig": {
		"root": true,
		"env": {
			"node": true
		},
		"extends": [
			"plugin:vue/recommended",
			"@vue/airbnb"
		],
		"rules": {
			"no-tabs": 0,
			"indent": 0,
			"import/extensions": 0,
			"linebreak-style": 0,
			"arraysInObjects": 0,
			"object-curly-spacing": [
				"error",
				"never"
			],
			"arrow-parens": [
				"error",
				"as-needed"
			],
			"no-shadow": 0,
			"no-param-reassign": 0,
			"vue/comment-directive": 0,
			"no-multiple-empty-lines": 0,
			"no-trailing-spaces": 0,
			"comma-dangle": [
				"error",
				{
					"functions": "never",
					"arrays": "ignore",
					"objects": "ignore",
					"imports": "ignore",
					"exports": "ignore"
				}
			],
			"implicit-arrow-linebreak": 0,
			"function-paren-newline": 0,
			"vue/no-mutating-props": 0,
			"import/no-extraneous-dependencies": 0,
			"no-underscore-dangle": 0,
			"import/prefer-default-export": 0,
			"vue/max-attributes-per-line": 0,
			"vue/html-indent": 0,
			"vue/no-v-html": 0,
			"vue/html-self-closing": 0,
			"vue/singleline-html-element-content-newline": 0,
			"vue/no-template-shadow": 0,
			"object-curly-newline": 0,
			"max-len": 0,
			"padded-blocks": 0,
			"operator-linebreak": 0,
			"no-plusplus": 0
		},
		"parserOptions": {
			"parser": "babel-eslint"
		}
	},
	"browserslist": [
		"> 1%",
		"not dead"
	],
	"jest": {
		"moduleFileExtensions": [
			"js",
			"json",
			"vue"
		],
		"transform": {
			".*\\.(vue)$": "vue-jest",
			"^.+\\.js$": "<rootDir>/node_modules/babel-jest"
		},
		"transformIgnorePatterns": [
			"/node_modules/(?!@babel/runtime)"
		],
		"moduleNameMapper": {
			"^@/(.*)$": "<rootDir>/src/$1"
		},
		"testEnvironment": "jsdom"
	}
}
