{
	"name": "form-generator",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"serve": "cross-env CUSTOM_MODE=dev vue-cli-service serve",
		" ": "",
		"build:min": "npm run _cp:all-asset-files && cross-env CUSTOM_MODE=prod vue-cli-service build",
		"build:full         (with sourcemap, with comments, logs)": "npm run _cp:all-asset-files && cross-env CUSTOM_MODE=dev vue-cli-service build",
		"present: deploy": "wrangler publish",
		"  ": "",
		"lint": "vue-cli-service lint --no-fix --ext .ts,.js,.vue ./src/",
		"test": "jest",
		"analyze": "cross-env CUSTOM_MODE=analyze vue-cli-service build",
		"    ": "",
		"_cp:all-asset-files": "npm run _cp:all-to-dev-site-dir && npm run _cp:all-to-public-dir",
		"      ": "",
		"_cp:all-to-dev-site-dir": "npm run _cp:d:bundle && npm run _cp:d:scheme-locales && npm run _cp:d:loader",
		"_cp:d:bundle": "cpy dist/*.js dev-site/assets",
		"_cp:d:scheme-locales": "cpy ../forms-jsons/*.json dev-site/assets",
		"_cp:d:loader": "cpy ../forms-loader/dist/*.js dev-site/assets",
		"     ": "",
		"_cp:all-to-public-dir": "npm run _cp:p:scheme-locales && npm run _cp:p:loader",
		"_cp:p:scheme-locales": "cpy ../forms-jsons/*.json public/assets",
		"_cp:p:loader": "cpy ../forms-loader/dist/*.js public/assets"
	},
	"dependencies": {
		"document-register-element": "^1.11.0",
		"v-mask": "^2.3.0",
		"vue": "^2.5.16",
		"vue-custom-element": "^3.2.2",
		"vuex": "^3.0.1"
	},
	"devDependencies": {
		"@babel/plugin-transform-modules-commonjs": "^7.15.4",
		"@babel/preset-env": "^7.16.4",
		"@babel/preset-typescript": "^7.17.12",
		"@jest/globals": "^27.2.3",
		"@typescript-eslint/parser": "^5.28.0",
		"@vue/cli-plugin-babel": "~5.0.0",
		"@vue/cli-plugin-eslint": "^5.0.8",
		"@vue/cli-service": "^5.0.8",
		"@vue/eslint-config-airbnb": "^5.3.0",
		"@vue/test-utils": "^1.2.2",
		"babel-core": "^7.0.0-bridge.0",
		"babel-jest": "^27.2.3",
		"cpy-cli": "^4.2.0",
		"cross-env": "^7.0.3",
		"eslint": "^7.32.0",
		"eslint-plugin-vue": "^7.18.0",
		"jest": "^27.2.3",
		"jsdom": "^17.0.0",
		"node-sass": "8.0.0",
		"sass": "^1.42.1",
		"sass-loader": "^13.2.0",
		"serve": "^14.2.0",
		"vue-template-compiler": "^2.5.16",
		"webpack": "^5.75.0",
		"webpack-bundle-analyzer": "^4.4.2"
	},
	"browserslist": [
		"> 0.5%",
		"not dead"
	],
	"jest": {
		"moduleFileExtensions": [
			"js",
			"json",
			"vue",
			"ts"
		],
		"transform": {
			"^.+\\.js$": "<rootDir>/node_modules/babel-jest",
			"^.+\\.ts$": "<rootDir>/node_modules/babel-jest"
		},
		"moduleNameMapper": {
			"^@/(.*)$": "<rootDir>/src/$1"
		}
	}
}
